# Database Connection Settings
spring.datasource.url=jdbc:mysql://localhost:3306/asha_boutique1?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
spring.datasource.username=root
spring.datasource.password=YOUR_DATABASE_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA / Hibernate settings
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect

# Logging Settings
logging.level.org.springframework.security=DEBUG
logging.level.org.hibernate.SQL=DEBUG

# Server Port Configuration
server.port=8080

# JWT Custom Properties
app.jwt.secret=YOUR_JWT_SECRET_KEY_AT_LEAST_256_BITS_BASE64_ENCODED
app.jwt.expiration-ms=86400000

# Multipart File Upload Properties
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=50MB

# Razorpay Credentials (Sandbox/Test Mode)
razorpay.key.id=YOUR_RAZORPAY_KEY_ID
razorpay.key.secret=YOUR_RAZORPAY_KEY_SECRET

# Demo UPI Configuration
demo.upi.id=YOUR_UPI_VPA_ID
